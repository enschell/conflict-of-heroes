{
  "name": "conflict-of-heroes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser edition of Conflict of Heroes: Awakening the Bear (personal, hotseat-first).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "play": "tsx scripts/play.ts",
    "demo": "tsx scripts/play.ts --demo",
    "conformance": "tsx scripts/conformance.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
